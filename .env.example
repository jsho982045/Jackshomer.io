# Copy to .env (never commit .env). Used by `npm run ask` locally.
GEMINI_API_KEY=
# Optional
# ASK_MODEL=gemini-3.5-flash-lite
# DAILY_CAP=800
# ASK_MOCK=1   # canned answers, no API key needed

# Analytics (web service, build time). Public ID from cloud.umami.is; leave empty locally.
VITE_UMAMI_WEBSITE_ID=
